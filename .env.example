# ===========================================
# E-Commerce Multi-Vendor SaaS Platform
# ===========================================

# Database
DB_USERNAME=ecommerce
DB_PASSWORD=ecommerce123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail (MailHog/MailDev for dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-256-bits-long-for-production
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ecommerce-images

# Stripe (sandbox keys)
STRIPE_API_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Elasticsearch
ES_HOST=localhost
ES_PORT=9200

# Server
SERVER_PORT=8081

# Observabilidad (prod)
# LOG_STRUCTURED_FORMAT lo fija el perfil 'prod' a ECS; aquí solo documentamos los ajustables.
TRACING_SAMPLE_RATE=1.0
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# OAuth2 (login social con Google, opcional)
# Sin estas dos, cae en un placeholder no vacío (Boot exige client-id no-blank para poder
# arrancar) y la app funciona igual; solo falla -en Google, no acá- si alguien entra a
# /oauth2/authorization/google sin credenciales reales. Sacarlas en
# https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_FRONTEND_REDIRECT_URI=http://localhost:3000/oauth2/callback
